# Database
# SQLite database URL (default for local development)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth.js Authentication
# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# Secret key for signing JWT tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"

# OpenAI API
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Client-side OpenAI API key (if needed for browser-side calls)
# Note: Be cautious exposing API keys in the browser
NEXT_PUBLIC_OPENAI_API_KEY="sk-your-openai-api-key-here"

# Environment
NODE_ENV="development"
